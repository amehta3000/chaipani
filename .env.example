# Copy to .env and fill in.

# Supabase Postgres. In your Supabase dashboard click "Connect" and copy:
#  - DATABASE_URL  = the "Transaction pooler" string (port 6543), with ?pgbouncer=true added
#  - DIRECT_URL    = the "Session pooler" string (port 5432)
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# Secret used to sign login session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Anthropic API key for the Chai Companion chatbot (https://platform.claude.com)
ANTHROPIC_API_KEY=""

# Comma-separated emails that get admin access (member approval dashboard)
ADMIN_EMAILS="ameet3000@gmail.com"

# In development, login codes are printed to the server console and shown
# in the UI. Set to "true" only while testing.
SHOW_DEV_LOGIN_CODE="true"
